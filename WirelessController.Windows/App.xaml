<Application x:Class="WirelessController.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Color x:Key="AccentColor">#718398</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#F0F3F6"/>
        <SolidColorBrush x:Key="TextBrush" Color="#1E2935"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#6D7A88"/>
        <SolidColorBrush x:Key="LineBrush" Color="#D9E1E9"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#15945B"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#D93D48"/>
        <SolidColorBrush x:Key="ConnectingBrush" Color="#8793A1"/>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="39"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#586A7C"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                    <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E4EAF0"/></Trigger>
                    <Trigger Property="Tag" Value="Active"><Setter TargetName="Bd" Property="Background" Value="#DCE4EC"/><Setter Property="Foreground" Value="#344D65"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="Background" Value="#718398"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#5D7186"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#43586C"/>
            <Setter Property="BorderBrush" Value="#D5DEE7"/><Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7C8A98"/><Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
        <Style x:Key="PageHeadingStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1F2C39"/><Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="BodyHintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#738292"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#34485A"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,7,0,7"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#F9FBFD"/><Setter Property="Foreground" Value="#26394A"/>
            <Setter Property="BorderBrush" Value="#D6E0E8"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="12"/>
        </Style>
    </Application.Resources>
</Application>
